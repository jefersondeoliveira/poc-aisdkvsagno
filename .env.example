# Provider: FAL OpenAI-compatible router (endpoint id: openrouter/router/openai/v1/chat/completions,
# see https://fal.ai/models/openrouter/router/openai/v1/chat/completions/api).
# Auth header format is "Authorization: Key <FAL_KEY>" (fal convention) -- validated by scripts/smoke_fal.sh.
FAL_KEY=
FAL_BASE_URL=https://fal.run/openrouter/router/openai/v1
FAL_MODEL=google/gemini-2.5-flash

# Fallback (Ollama, local): FAL_BASE_URL=http://localhost:11434/v1  FAL_MODEL=qwen2.5:7b  FAL_KEY=ollama

# Telegram (two bots from @BotFather: Telegram allows only one of webhook/polling per bot)
TELEGRAM_BOT_TOKEN_AISDK=
TELEGRAM_BOT_USERNAME_AISDK=
TELEGRAM_BOT_TOKEN_AGNO=
# Any random string (used by Telegram to sign webhook calls to Agno): openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Optional: restrict the AI SDK bot to your Telegram user id(s), comma separated
TELEGRAM_ALLOWED_USER_IDS=
